      "--glass-text-primary": "var(--color-fg)",
      "--glass-text-secondary": "var(--color-fg-muted)",
      "--glass-text-muted": "color-mix(in oklch, var(--color-fg-muted) 84%, var(--color-fg) 16%)",
      "--glass-text-accent": "var(--color-accent)",
      "--glass-blue-950": "var(--color-fg)",
      "--glass-blue-900": "color-mix(in oklch, var(--color-accent) 82%, var(--color-fg) 18%)",
      "--glass-blue-700": "var(--color-accent)",
      "--glass-blue-600": "var(--color-accent)",
      "--glass-blue-500": "color-mix(in oklch, var(--color-accent) 80%, var(--color-fg-on-accent) 20%)",
      "--glass-ice-500": "var(--color-info)",
      "--glass-warm-500": "var(--color-warning)",
      "--glass-shell-bg": "var(--glass-surface-strong)",
      "--glass-shell-border": "var(--glass-border-soft)",
      "--glass-shell-shadow": "var(--shadow-lg)",
      "--glass-panel-bg": "var(--glass-surface)",
      "--glass-panel-border": "var(--glass-border-subtle)",
      "--glass-panel-shadow": "var(--shadow-md)",
      "--glass-caustic-streak": "color-mix(in oklch, var(--color-accent) 12%, transparent)",
      "--glass-caustic-streak-soft": "color-mix(in oklch, var(--color-accent) 8%, transparent)",
      "--glass-reflection": "linear-gradient(135deg, transparent 0%, color-mix(in oklch, var(--color-surface-elevated) 42%, transparent) 50%, transparent 100%)",
      "--glass-reflection-blend": "normal",
      "--glass-primary-bg": "var(--color-accent)",
      "--glass-primary-border": "color-mix(in oklch, var(--color-accent) 70%, var(--color-border) 30%)",
